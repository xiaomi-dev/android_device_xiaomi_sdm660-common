# TODO(b/36644492): Remove data_between_core_and_vendor_violators once
# tee no longer directly accesses /data owned by the frameworks.
typeattribute tee data_between_core_and_vendor_violators;
allow tee system_data_file:dir r_dir_perms;
# Allow tee to create the fpdata directory under /data/system/users/[0-9]+/
allow tee system_data_file:dir create_dir_perms;
# Label the created fpdata directory as fingerprintd_data_file so the
# existing fingerprintd_data_file rules below apply to it.
type_transition tee system_data_file:dir fingerprintd_data_file "fpdata";
allow tee fingerprintd_data_file:dir rw_dir_perms;
allow tee fingerprintd_data_file:dir create;
allow tee fingerprintd_data_file:file create_file_perms;
